    },
    "Add an app…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir una app…"
          }
        }
      }
    },
    "Add it" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir"
          }
        }
      }
    },
    "Add recording" : {
