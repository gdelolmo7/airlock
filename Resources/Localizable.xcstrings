        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus próximas reuniones, con enlaces para unirte"
          }
        }
      }
    },
    "Your notch becomes a control surface for terminal coding agents — approve what they want to run, see what they're doing, and jump back to the terminal." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu notch se convierte en un panel de control para los agentes de programación del terminal: aprueba lo que quieren ejecutar, mira lo que están haciendo y vuelve al terminal."
          }
        }
      }
    },
