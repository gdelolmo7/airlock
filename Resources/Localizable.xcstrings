    },
    "Apple Intelligence isn't available on this Mac, for example because of its region or language. Plus writes notes online, on any Mac. The transcript is ready." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence no está disponible en este Mac, por ejemplo por su región o idioma. Plus escribe las notas online, en cualquier Mac. La transcripción está lista."
          }
        }
      }
    },
    "Apple Intelligence isn't available on this Mac, for example because of its region or language. The transcript is ready." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence no está disponible en este Mac, por ejemplo por su región o idioma. La transcripción está lista."
          }
        }
      }
    },
    "Apple's notes writer can't read %@ yet: add a second language it reads, and the notes are written from that listening." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
