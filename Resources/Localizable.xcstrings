    "Add a key" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir una clave"
          }
        }
      }
    },
    "Add a modifier — ⌘, ⌥, ⌃ or ⇧. A key on its own would be taken from every app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
