          }
        }
      }
    },
    "This copy of Airlock can't check licence keys — that's on our side, not yours. Download Airlock again from useairlock.app, or write to hello@useairlock.app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia de Airlock no puede comprobar claves de licencia; el problema es nuestro, no tuyo. Descarga Airlock de nuevo desde useairlock.app o escribe a hello@useairlock.app."
          }
        }
      }
    },
    "This file is being ignored entirely, so only Airlock's built-in checks are in effect: risky commands still ask." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo se ignora por completo, así que solo rigen las comprobaciones propias de Airlock: los comandos arriesgados siguen preguntando."
          }
        }
      }
    },
    "This file is being ignored entirely, so this project is running on the Everywhere rules alone — including its Never runs list." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo se ignora por completo, así que este proyecto funciona solo con las reglas de «En todas partes», incluida su lista «Nunca se ejecuta»."
          }
        }
      }
    },
