            "value" : "Añadir grabación"
          }
        }
      }
    },
    "Add selection" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir selección"
          }
        }
      }
    },
    "Added %@ rule %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Added %1$@ rule %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regla de %@ añadida: %@."
          }
        }
      }
    },
    "Adding %@…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadiendo %@…"
          }
        }
      }
    },
    "Adding…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadiendo…"
          }
        }
      }
    },
    "Adds whatever is selected in Finder, leaving the originals in place." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade lo que esté seleccionado en el Finder, sin mover los originales."
          }
        }
      }
    },
    "Advanced" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avanzado"
          }
        }
      }
    },
    "After a warning, once that limit is back to zero" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras un aviso, cuando ese límite vuelva a cero"
          }
        }
      }
    },
    "After each update, this card tells you what changed. Once." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras cada actualización, esta tarjeta te cuenta qué ha cambiado. Una vez."
          }
        }
      }
    },
    "Agent idle" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agente inactivo"
          }
        }
      }
    },
    "Agent needs an answer" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El agente necesita una respuesta"
          }
        }
      }
    },
    "Agent requests — always first, can't be moved" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitudes de agentes: siempre primero, no se pueden mover"
          }
        }
      }
    },
    "Agent working" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agente trabajando"
          }
        }
      }
    },
    "Agents" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agentes"
          }
        }
      }
    },
    "Agents are off." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los agentes están desactivados."
          }
        }
      }
    },
    "Agents tab" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pestaña Agentes"
          }
        }
      }
    },
    "AirDrop can only send files." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirDrop solo puede enviar archivos."
          }
        }
      }
    },
    "AirDrop isn't available for %@." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirDrop no está disponible para %@."
          }
        }
      }
    },
    "AirDrop…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirDrop…"
          }
        }
      }
    },
    "Airlock %@ is downloaded and installs when you quit Airlock." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock %@ se ha descargado y se instalará al salir de Airlock."
          }
        }
      }
    },
    "Airlock Website" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web de Airlock"
          }
        }
      }
    },
    "Airlock adds your mark to the usage counts this Mac sends, so your numbers page can leave them out when Hide me is on. Nothing else changes." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock añade tu marca a los recuentos de uso que envía este Mac, para que tu página de cifras pueda excluirlos cuando «Hide me» está activado. No cambia nada más."
          }
        }
      }
    },
    "Airlock already looks on, but macOS isn't passing %@ along. In the list that opens, remove Airlock with –, then add it back with +." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock ya aparece activado, pero macOS no le pasa %@. En la lista que se abre, quita Airlock con – y vuelve a añadirlo con +."
          }
        }
      }
    },
    "Airlock asks once, on its second launch, whether it may check for updates — and does nothing if you say no. A check fetches one small file and sends nothing about you." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock pregunta una vez, al abrirse por segunda vez, si puede buscar actualizaciones, y no hace nada si dices que no. Cada búsqueda descarga un archivo pequeño y no envía nada sobre ti."
          }
        }
      }
    },
    "Airlock can only add events, so your meetings can't show here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock solo puede añadir eventos, así que tus reuniones no pueden aparecer aquí."
          }
        }
      }
    },
    "Airlock can't answer this one for it. Answer it in the terminal." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock no puede responder a esta por él. Respóndela en el terminal."
          }
        }
      }
    },
    "Airlock can't read “%@” as sound. Try one saved as M4A, MP3 or WAV." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock no puede leer «%@» como sonido. Prueba con uno guardado en M4A, MP3 o WAV."
          }
        }
      }
    },
    "Airlock can't see your dictation key" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock no detecta tu tecla de dictado"
          }
        }
      }
    },
    "Airlock can't type yet" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock aún no puede escribir"
          }
        }
      }
    },
    "Airlock can't use the microphone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock no puede usar el micrófono."
          }
        }
      }
    },
    "Airlock couldn't answer that. Try asking another way." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock no ha podido responder a eso. Prueba a preguntarlo de otra forma."
          }
        }
      }
    },
    "Airlock couldn't get the speech model for your language. Check that this Mac is online, then take notes again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock no ha podido obtener el modelo de voz para tu idioma. Comprueba que este Mac tiene conexión y vuelve a tomar notas."
          }
        }
      }
    },
    "Airlock couldn't reach the internet, so your key hasn't been checked yet. Airlock keeps working — try again when you're back online." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock no ha podido conectarse a internet, así que aún no ha comprobado tu clave. Airlock sigue funcionando: vuelve a intentarlo cuando tengas conexión."
          }
        }
      }
    },
    "Airlock couldn't save the notes in your Meetings folder." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock no ha podido guardar las notas en tu carpeta Reuniones."
          }
        }
      }
    },
    "Airlock didn't have an answer for that. Try asking another way." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock no tenía respuesta para eso. Prueba a preguntarlo de otra forma."
          }
        }
      }
    },
    "Airlock hasn't been able to confirm your last payment. Update your card under Manage subscription; this clears itself the next time Airlock reaches the licence server. Not sure how? Write to hello@useairlock.app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock no ha podido confirmar tu último pago. Actualiza tu tarjeta en Gestionar suscripción; esto desaparece solo la próxima vez que Airlock contacte con el servidor de licencias. ¿No sabes cómo? Escribe a hello@useairlock.app."
          }
        }
      }
    },
    "Airlock is free" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock es gratis"
          }
        }
      }
    },
    "Airlock is switched off under %@ in System Settings, %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock is switched off under %1$@ in System Settings, %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock está desactivado en %@ en Ajustes del Sistema, %@."
          }
        }
      }
    },
    "Airlock is taking notes" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock está tomando notas"
          }
        }
      }
    },
    "Airlock isn't allowed to control %@, so it can't show what's playing." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock no tiene permiso para controlar %@, así que no puede mostrar lo que suena."
          }
        }
      }
    },
    "Airlock isn't allowed to control %@. Allow it under Automation in System Settings, then try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock no tiene permiso para controlar %@. Permítelo en Automatización, en Ajustes del Sistema, y vuelve a intentarlo."
          }
        }
      }
    },
    "Airlock isn't allowed to see what's selected in Finder. Turn on Finder for Airlock in Privacy & Security › Automation." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock no tiene permiso para ver lo seleccionado en el Finder. Activa Finder para Airlock en Privacidad y seguridad › Automatización."
          }
        }
      }
    },
    "Airlock isn't allowed to type yet, so your words are on the clipboard." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock aún no tiene permiso para escribir, así que tus palabras están en el portapapeles."
          }
        }
      }
    },
    "Airlock keeps working, and nothing you made is gone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock sigue funcionando y no se ha perdido nada de lo que hiciste."
          }
        }
      }
    },
    "Airlock makes no sound. The notch still opens when a request needs you." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock no emite sonidos. El notch se sigue abriendo cuando una solicitud te necesita."
          }
        }
      }
    },
    "Airlock needs Accessibility to type" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock necesita Accesibilidad para escribir"
          }
        }
      }
    },
    "Airlock needs its macOS permissions again" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock necesita de nuevo sus permisos de macOS"
          }
        }
      }
    },
    "Airlock needs your permission to read them" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock necesita tu permiso para leerlos"
          }
        }
      }
    },
    "Airlock never asks for a permission on launch. Each one is asked for the first time the feature that needs it is used, so saying no only ever costs you that one feature." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock nunca pide permisos al abrirse. Cada uno se pide la primera vez que se usa la función que lo necesita, así que decir que no solo te cuesta esa función."
          }
        }
      }
    },
    "Airlock no longer quits by itself after a call. Quitting mid-notes asks first." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock ya no se cierra solo tras una llamada. Si sales mientras toma notas, te lo pregunta antes."
          }
        }
      }
    },
    "Airlock now comes as Free, Plus or Pro. Settings › Plans shows yours and what each adds." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock ahora viene en Free, Plus o Pro. En Ajustes › Planes ves el tuyo y lo que añade cada uno."
          }
        }
      }
    },
    "Airlock quit unexpectedly" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock se cerró inesperadamente"
          }
        }
      }
    },
    "Airlock reads one recording at a time" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock lee una grabación cada vez"
          }
        }
      }
    },
    "Airlock speaks Spanish now. It follows your Mac's language, or choose one in Settings › General." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock ya habla español. Sigue el idioma de tu Mac, o elige otro en Ajustes › General."
          }
        }
      }
    },
    "Airlock was listening, but no sound came in. Check that the right microphone is chosen, or hold the key again and speak closer." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock estaba escuchando, pero no llegó ningún sonido. Comprueba que está elegido el micrófono correcto, o mantén pulsada la tecla otra vez y habla más cerca."
          }
        }
      }
    },
    "Airlock writes call notes with Apple Intelligence, and it's switched off. The transcript of this call is ready." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airlock escribe las notas de llamada con Apple Intelligence, y está desactivado. La transcripción de esta llamada está lista."
          }
        }
      }
    },
    "Airlock writes call notes with Apple Intelligence, which is switched off." : {
