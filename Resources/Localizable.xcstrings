    },
    "Subscribed before plans came? You're on Plus and keep everything you had." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te suscribiste antes de que hubiera planes? Estás en Plus y conservas todo lo que tenías."
          }
        }
      }
    },
    "Subscribers can have call notes written online, with better summaries and to-dos." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los suscriptores pueden recibir las notas de llamada escritas online, con mejores resúmenes y tareas."
          }
        }
      }
    },
    "Subscribers' call notes are now written online by default, no question asked." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora las notas de llamada de los suscriptores se escriben online por defecto, sin preguntar."
