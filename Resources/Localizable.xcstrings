          }
        }
      }
    },
    "line %lld: “%@” needs a value after the colon." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "line %1$lld: “%2$@” needs a value after the colon."
