    "%@ is connected. Start it in any terminal and it shows up here, with anything it asks." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está conectado. Ábrelo en cualquier terminal y aparecerá aquí, con todo lo que pregunte."
          }
        }
      }
    },
    "%@ is keeping your typing private, so the notch waits a second before it opens." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ protege lo que escribes, así que el notch espera un segundo antes de abrirse."
          }
        }
      }
    },
    "%@ is no longer in %@ — it may have been edited outside Airlock." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is no longer in %2$@ — it may have been edited outside Airlock."
