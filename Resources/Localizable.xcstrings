    },
    " %lld" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " %lld"
          }
        }
      }
    },
    "—" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "—"
          }
        }
      }
    },
    "“%@”" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@»"
          }
        }
      }
    },
    "“%@” is waiting for your answer in %@. The notch can't answer it any more." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” is waiting for your answer in %2$@. The notch can't answer it any more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» espera tu respuesta en %@. El notch ya no puede responderla."
          }
        }
      }
    },
    "“%@” is waiting for your answer in its terminal. The notch can't answer it any more." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» espera tu respuesta en su terminal. El notch ya no puede responderla."
          }
        }
      }
    },
    "“Not now” hides this for %lld days" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ahora no» oculta esto durante %lld días"
          }
        }
      }
    },
    "→" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "→"
          }
        }
      }
    },
    "↩" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↩"
          }
        }
      }
    },
    "↩ picks the first choice. For another, press ⌘ and its number." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↩ elige la primera opción. Para otra, pulsa ⌘ y su número."
          }
        }
      }
    },
    "⇧ Shift" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⇧ Mayúsculas"
          }
        }
      }
    },
    "⇧⌘A is also Finder's Applications folder. A global shortcut wins, so Finder won't see it while Airlock is running — pick ⌃⌥⌘A above if you'd rather keep it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⇧⌘A también abre la carpeta Aplicaciones del Finder. Un atajo global tiene prioridad, así que el Finder no lo verá mientras Airlock esté abierto. Elige ⌃⌥⌘A arriba si prefieres conservarlo."
          }
        }
      }
    },
    "⇧⌘C is also Maccy's default. If Maccy is still running, one of the two will get the key and it won't be predictable which." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⇧⌘C también es el atajo por defecto de Maccy. Si Maccy sigue abierto, una de las dos apps se quedará la tecla y no se sabe cuál."
          }
        }
      }
    },
    "⌃ Control" : {
      "localizations" : {
        "es" : {
