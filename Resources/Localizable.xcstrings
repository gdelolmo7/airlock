    "Nothing is auto-approved — every request asks." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se aprueba nada automáticamente — cada solicitud pregunta."
          }
        }
      }
    },
    "Nothing is auto-denied." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se deniega nada automáticamente."
          }
        }
      }
    },
    "Nothing is being written down: Airlock isn't allowed to use the microphone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se está escribiendo nada: Airlock no tiene permiso para usar el micrófono."
          }
        }
      }
    },
    "Nothing is counted unless you say yes. You can change this in Settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se cuenta nada a menos que digas que sí. Puedes cambiarlo en Ajustes."
          }
        }
      }
    },
    "Nothing is listening for this answer. The session drops off the tab when you dismiss." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada está esperando esta respuesta. La sesión desaparece de la pestaña cuando la descartes."
          }
        }
      }
    },
    "Nothing is lost while one is off — the feature that needs it just stays off until you turn it on." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pierde nada mientras uno está desactivado — la función que lo necesita simplemente sigue desactivada hasta que lo actives."
          }
        }
      }
    },
    "Nothing is selected in Finder." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay nada seleccionado en el Finder."
          }
        }
      }
    },
    "Nothing is ticked, so the calendar shows no events. Tick one to bring it back." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay nada marcado, así que el calendario no muestra eventos. Marca uno para recuperarlos."
          }
        }
      }
    },
    "Nothing is written down while paused." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se apunta nada mientras está en pausa."
          }
        }
      }
    },
    "Nothing left to ask for" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya no queda nada que pedir"
          }
        }
      }
    },
    "Nothing left today." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada más por hoy."
          }
        }
      }
    },
    "Nothing matches %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada coincide con %@"
          }
        }
      }
    },
    "Nothing on %@." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada el %@."
          }
        }
      }
    },
    "Nothing playing, nothing scheduled." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada sonando, nada programado."
          }
        }
      }
    },
    "Nothing said until you resume is written down" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se apunta nada de lo que se diga hasta que reanudes"
          }
        }
      }
    },
    "Nothing to report" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada que informar"
          }
        }
      }
    },
    "Nothing to type into — copied to your clipboard." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay dónde escribir — copiado al portapapeles."
          }
        }
      }
    },
    "Nothing was changed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha cambiado nada."
          }
        }
      }
    },
    "Nothing was changed. In the list that opened, remove Airlock with –, then add it back with +." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha cambiado nada. En la lista que se ha abierto, quita Airlock con – y vuelve a añadirlo con +."
          }
        }
      }
    },
    "Nothing was heard on this call, so there is nothing to summarise." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se oyó nada en esta llamada, así que no hay nada que resumir."
          }
        }
      }
    },
    "Nothing was heard yet." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no se ha oído nada."
          }
        }
      }
    },
    "Nothing will paste until Airlock has the Accessibility permission." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pegará nada hasta que Airlock tenga el permiso de Accesibilidad."
          }
        }
      }
    },
    "Nothing written down" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha apuntado nada"
          }
        }
      }
    },
    "Nothing yet — the built-in phrases below already cover the common ones." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún nada — las frases integradas de abajo ya cubren las más comunes."
          }
        }
      }
    },
    "Nothing yet. Every request your agents make — and everything your rules settle without asking — shows up here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún nada. Cada solicitud de tus agentes — y todo lo que tus reglas resuelven sin preguntar — aparece aquí."
          }
        }
      }
    },
    "Notices the dictation key you hold, nothing you type" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detecta la tecla de dictado que mantienes pulsada, nada de lo que escribes"
          }
        }
      }
    },
    "Now" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora"
          }
        }
      }
    },
    "Numbers the other side Person 1, Person 2… by sound, on your Mac. Never names anyone, and remembers no voice after the call" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numera a los del otro lado como Persona 1, Persona 2… por su voz, en tu Mac. Nunca pone nombre a nadie y no recuerda ninguna voz tras la llamada"
          }
        }
      }
    },
    "Numbers the other side Person 1, Person 2… by sound, on your Mac. Never names anyone, and remembers no voice after the call. Its model, about %lld MB, downloads by itself once" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numera a los del otro lado como Persona 1, Persona 2… por su voz, en tu Mac. Nunca pone nombre a nadie y no recuerda ninguna voz tras la llamada. Su modelo, de unos %lld MB, se descarga solo una vez"
          }
        }
      }
    },
    "Numbers the other side of a call Person 1, Person 2… by sound, on your Mac. On Free, everyone on the other side is “Them”." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numera a los del otro lado de una llamada como Persona 1, Persona 2… por su voz, en tu Mac. En Free, todos los del otro lado son «Ellos»."
          }
        }
      }
    },
    "OK" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceptar"
          }
        }
      }
    },
    "Off" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado"
          }
        }
      }
    },
    "Off because you turned it off, so the Agents tab, the agent icons beside the notch and Claude usage are hidden. Connecting an agent won't change that." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado porque lo desactivaste, así que la pestaña Agentes, los iconos de agentes junto al notch y el uso de Claude están ocultos. Conectar un agente no lo cambia."
          }
        }
      }
    },
    "Off until you turn it on. Turning it off stops it at once and deletes any report not sent yet." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado hasta que lo actives. Al desactivarlo se detiene al momento y se borra cualquier informe aún no enviado."
          }
        }
      }
    },
    "Off — hears %@ only" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado — solo oye %@"
          }
        }
      }
    },
    "Off — this Mac also uses %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado — este Mac también usa %@"
          }
        }
      }
    },
    "Off — turning it on starts the model download" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado — al activarlo empieza la descarga del modelo"
          }
        }
      }
    },
    "Off, only while the Mac is plugged in" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado, solo mientras el Mac está enchufado"
          }
        }
      }
    },
    "Off: no coding agent is connected on this Mac. Switch it on to connect Claude Code or Codex. Connecting one turns this on by itself." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: no hay ningún agente de programación conectado en este Mac. Actívalo para conectar Claude Code o Codex. Al conectar uno, esto se activa solo."
          }
        }
      }
    },
    "Offers to take notes when a call starts. " : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ofrece a tomar notas cuando empieza una llamada. "
          }
        }
      }
    },
    "On" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activado"
          }
        }
      }
    },
    "On Free, a call past 30 minutes is kept on your Mac for 7 days. Plus opens it, sending only a key." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Free, una llamada de más de 30 minutos se guarda en tu Mac 7 días. Plus la abre enviando solo una clave."
          }
        }
      }
    },
    "On Free, the clipboard shows your last %lld copies, the notch answers one coding agent at a time, and call notes cover the first %lld minutes of each call." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On Free, the clipboard shows your last %1$lld copies, the notch answers one coding agent at a time, and call notes cover the first %2$lld minutes of each call."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Free, el portapapeles muestra tus últimas %lld copias, el notch responde a un agente de programación a la vez y las notas de llamada cubren los primeros %lld minutos de cada llamada."
          }
        }
      }
    },
    "On Free, the notch answers one coding agent at a time. Others ask in their own terminal." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Free, el notch responde a un agente de programación a la vez. Los demás preguntan en su propio terminal."
          }
        }
      }
    },
    "On Free, the other side stays “Them”. Settings › Voice shows what Plus adds." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Free, el otro lado sigue siendo «Ellos». Ajustes › Voz muestra lo que añade Plus."
          }
        }
      }
    },
    "On Plus and Pro, call notes go topic by topic, with to-dos by person and words to check." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Plus y Pro, las notas de llamada van tema por tema, con tareas por persona y palabras que revisar."
          }
        }
      }
    },
    "On Plus and Pro, call notes tell the voices apart: Person 1, Person 2… Name them after." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Plus y Pro, las notas de llamada distinguen las voces: Persona 1, Persona 2… Ponles nombre después."
          }
        }
      }
    },
    "On Plus, %@." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Plus, %@."
          }
        }
      }
    },
    "On a call in %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En una llamada en %@"
          }
        }
      }
    },
    "On because a coding agent is connected. A request waiting for your answer always shows, whatever this says, so an agent is never left waiting on nobody." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activado porque hay un agente de programación conectado. Una solicitud que espera tu respuesta siempre se muestra, diga lo que diga esto, para que ningún agente se quede esperando a nadie."
          }
        }
      }
    },
    "On because you turned it on. Connecting or disconnecting an agent won't change that." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activado porque lo activaste. Conectar o desconectar un agente no lo cambia."
          }
        }
      }
    },
    "On your Mac, basic model" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu Mac, modelo básico"
          }
        }
      }
    },
    "On, but not working" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activado, pero no funciona"
          }
        }
      }
    },
    "On, but nothing is connected yet: the Agents tab is showing so you can connect from it. Once you do, the agent icons and Claude usage turn on too. Don't use coding agents? Switch this off and it stays off." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activado, pero aún no hay nada conectado: la pestaña Agentes se muestra para que puedas conectar desde ella. Cuando lo hagas, también se activan los iconos de agentes y el uso de Claude. ¿No usas agentes de programación? Desactívalo y se quedará desactivado."
          }
        }
      }
    },
    "On. %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activado. %@"
          }
        }
      }
