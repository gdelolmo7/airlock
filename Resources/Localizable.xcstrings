    "Remove it" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminarlo"
          }
        }
      }
    },
    "Remove takes the key off this Mac only; the subscription itself is untouched. One key covers one Mac; to move it, write to hello@useairlock.app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar solo quita la clave de este Mac; la suscripción no cambia. Una clave sirve para un Mac; para cambiarla de Mac, escribe a hello@useairlock.app."
          }
        }
      }
    },
    "Remove the background, leaving it see-through" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitar el fondo y dejarlo transparente"
          }
        }
      }
    },
    "Remove the key from this Mac? Your subscription isn't affected, and you can paste the key again at any time." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quitar la clave de este Mac? Tu suscripción no se ve afectada y puedes volver a pegar la clave cuando quieras."
          }
        }
      }
    },
    "Remove this phrase" : {
      "localizations" : {
