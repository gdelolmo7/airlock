    },
    "Ask %@: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask %1$@: %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preguntar a %@: %@"
          }
        }
      }
    },
    "Ask Airlock what you're trying to do. It looks at your screen, tells you the next step and points at where to click. You do the clicking." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dile a Airlock qué intentas hacer. Mira tu pantalla, te dice el siguiente paso y te señala dónde hacer clic. El clic lo haces tú."
          }
        }
      }
    },
    "Ask Claude Code" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
