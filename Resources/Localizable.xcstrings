    "Take it off this list and change nothing" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitarlo de esta lista sin cambiar nada"
          }
        }
      }
    },
    "Take notes" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomar notas"
          }
        }
      }
    },
    "Take notes of %@?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tomar notas de %@?"
          }
        }
      }
    },
    "Take your key off this Mac and use Free? Nothing you made is deleted, and you can paste the key back any time." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quitar tu clave de este Mac y usar Free? No se borra nada de lo que has hecho, y puedes volver a pegar la clave cuando quieras."
          }
        }
      }
    },
    "Takes notes of a meeting in the room, through this Mac's microphone" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toma notas de una reunión presencial con el micrófono de este Mac"
          }
        }
      }
    },
    "Takes notes of every call from now on, after a short countdown" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toma notas de cada llamada a partir de ahora, tras una breve cuenta atrás"
          }
        }
      }
    },
    "Takes notes of the call you're on" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toma notas de la llamada en la que estás"
          }
        }
      }
    },
    "Takes your key off this Mac. Nothing you made is deleted, and you can paste the key back any time." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita tu clave de este Mac. No se borra nada de lo que has hecho, y puedes volver a pegar la clave cuando quieras."
          }
        }
      }
    },
