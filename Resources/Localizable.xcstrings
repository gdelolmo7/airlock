    },
    "Your Mac is set to %@, so that is what dictation listens for. If you speak another language, pick it above: the region your Mac is set to says nothing about which language you talk in." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Mac está configurado en %@, así que el dictado escucha ese idioma. Si hablas otro, elígelo arriba: la región de tu Mac no dice nada del idioma en que hablas."
          }
        }
      }
    },
    "Your clipboard is full" : {
