    "%@ can't connect yet. Its settings file already has Airlock lines that Airlock didn't add, so it leaves them alone. Delete those lines, then connect again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aún no se puede conectar. Su archivo de ajustes ya tiene líneas de Airlock que Airlock no añadió, así que no las toca. Borra esas líneas y vuelve a conectar."
          }
        }
      }
    },
