            "value" : "Escritas por el mejor modelo que hemos probado"
          }
        }
      }
    },
    "Written from a %@ version of the call, because Apple Intelligence can't read %@ yet." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Written from a %1$@ version of the call, because Apple Intelligence can't read %2$@ yet."
