    "Automatic follows your Mac: Spanish if your Mac is in Spanish, English otherwise." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Automático» sigue a tu Mac: español si tu Mac está en español; inglés en otro caso."
