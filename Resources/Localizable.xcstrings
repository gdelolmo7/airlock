            "value" : "línea %lld: a «%@» le falta el paréntesis de cierre."
          }
        }
      }
    },
    "line %lld: “%@” isn't a setting Airlock knows. The ones it knows are version, ask_timeout, allow and deny." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "line %1$lld: “%2$@” isn't a setting Airlock knows. The ones it knows are version, ask_timeout, allow and deny."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
