    "This Mac also uses %@. Dictation hears %@ and nothing else until you add a second language." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac also uses %1$@. Dictation hears %2$@ and nothing else until you add a second language."
