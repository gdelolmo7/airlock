            "value" : "Calendario y reuniones"
          }
        }
      }
    },
    "Calendar shows your next meetings in the notch, with one-click join links. Read-only, and only the calendars you pick." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendario muestra tus próximas reuniones en el notch, con enlaces para unirte con un clic. Solo lectura, y solo los calendarios que elijas."
