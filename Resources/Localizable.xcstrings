            "value" : "¿Seguro?"
          }
        }
      }
    },
    "Switch Airlock on in the list that opens, so it notices you holding %@. It sees that key, not what you type." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Airlock en la lista que se abre para que detecte cuándo mantienes pulsada %@. Ve esa tecla, no lo que escribes."
          }
        }
      }
    },
    "Switch Airlock on under Microphone. Nothing is being written down until then." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Airlock en Micrófono. Hasta entonces no se escribe nada."
