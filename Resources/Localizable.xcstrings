    "Your trial ended on %@." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu prueba terminó el %@."
          }
        }
      }
    },
    "Your trial has ended." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu prueba ha terminado."
          }
        }
      }
    },
    "Your trial started before Airlock had plans, so it runs to its end with everything Plus has. Afterwards you're on Free: Airlock keeps working, and nothing you made is deleted. No card, and nothing to cancel." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu prueba empezó antes de que Airlock tuviera planes, así que dura hasta el final con todo lo que tiene Plus. Después pasas a Free: Airlock sigue funcionando y no se borra nada de lo que hayas hecho. Sin tarjeta y sin nada que cancelar."
          }
